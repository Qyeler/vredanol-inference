COMPOSE_PROJECT_NAME=vredanol-model

# ====================
# APP SETTINGS
# ====================
APP_NAME=Vredanol inference
APP_DESCRIPTION=ONNX classification inference service
APP_VERSION=1.0.0
LICENSE_NAME=MIT
CONTACT_NAME=Vredanol Team
CONTACT_EMAIL=team@example.com

# ====================
# MODEL SETTINGS
# ====================
MODEL_PATH=./models/convnext_tiny_food.data
MODEL_LABELS=[]
MODEL_CLASSES_PATH=./models/food_classes.txt
MODEL_IMAGE_SIZE=224
MODEL_RESIZE_SIZE=256
MODEL_NORMALIZE_MEAN=[0.485,0.456,0.406]
MODEL_NORMALIZE_STD=[0.229,0.224,0.225]
MODEL_INPUT_NAME=
MODEL_OUTPUT_NAME=
MODEL_PROVIDERS=["CPUExecutionProvider"]
MODEL_STARTUP_STRICT=true

# ====================
# CELERY
# ====================
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TIMEZONE=UTC
CELERY_INFERENCE_QUEUE=inference

# ====================
# LOGGER
# ====================
FILE_LOG_DIR=
FILE_LOG_MAX_BYTES=10485760
FILE_LOG_BACKUP_COUNT=5
FILE_LOG_FORMAT_JSON=true
FILE_LOG_LEVEL=INFO
FILE_LOG_INCLUDE_REQUEST_ID=true
FILE_LOG_INCLUDE_PATH=true
FILE_LOG_INCLUDE_METHOD=true
FILE_LOG_INCLUDE_CLIENT_HOST=true
FILE_LOG_INCLUDE_STATUS_CODE=true

CONSOLE_LOG_LEVEL=INFO
CONSOLE_LOG_FORMAT_JSON=false
CONSOLE_LOG_INCLUDE_REQUEST_ID=true
CONSOLE_LOG_INCLUDE_PATH=true
CONSOLE_LOG_INCLUDE_METHOD=true
CONSOLE_LOG_INCLUDE_CLIENT_HOST=true
CONSOLE_LOG_INCLUDE_STATUS_CODE=true
